__pycache__/
*.pyc
*.log
logs/
backups/
e2e_profile/
shot_*.png
config.json.tmp
.novabak
dist/
build-dist/

# Local staging areas and packaged build artifacts
.staging/
*.zip
*.7z
*.rar
*.tzyp
*.apk
*.exe
*.msi

# Unpacked app-package build directories (release .tzyp files are force-added selectively)
apps_repo/*/
!apps_repo/*.tzyp

# 构建缓存（下载的 embed 包 / get-pip.py）
build-cache/

# 内嵌便携 Python 运行时（由 build_runtime.ps1 生成，约 40MB，不入库）
runtime/

# 小说导出目录（运行时生成）
novel_exports/

# lncrawl 上游参考克隆（仅用于移植站点，含 .git，不入库）
archive/lncrawl-ref/

# 应用安装时落盘到电脑的静态文件目录（运行时生成，见 toolkit.app_data_*）
apps_data/

# 本地打包临时目录（build_all / 手动解包构建）
build/

# 书源验证/发现结果缓存（运行时生成）
novelsrc/source_verify.json
novelsrc/source_index.json
novelsrc/*.json.tmp
